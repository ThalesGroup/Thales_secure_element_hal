cc_binary {
    name: "android.hardware.secure_element@1.2-service-thales",
    relative_install_path: "hw",
    init_rc: ["android.hardware.secure_element@1.2-service-thales.rc"],
    vendor: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "SecureElement.cpp",
        "GtoService.cpp",
    ],

    local_include_dirs: [
        "se-thales",
    ],

    shared_libs: [
        "android.hardware.secure_element@1.0",
        "android.hardware.secure_element@1.1",
        "android.hardware.secure_element@1.2",
        "android.hardware.secure_element.thales.libse-thales",
        "libbase",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],

    cflags: [
        "-DANDROID",
        "-DENABLE_LOGGING=1",
        "-DENABLE_DEBUG=1",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
        "-Wno-error",
        "-Wreturn-type",
    ],

    sanitize: {
        memtag_heap: true,
    },
}