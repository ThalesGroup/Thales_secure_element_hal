        "legacy/src/api/libse-thales.c",
        "legacy/src/core/checksum.c",
        "legacy/src/core/iso7816_t1.c",
        "legacy/src/core/log.c",
        "legacy/src/driver/spi/spi.c",
        "legacy/src/driver/spi/transport.c",
    ],
 
    local_include_dirs: [
        "legacy/se-thales",
        "legacy/include/core",
        "legacy/include/linux",
        "legacy/include/driver",
        "legacy/include/driver/spi",
    ],
 
    cflags: [
        "-DANDROID",
        "-DENABLE_LOGGING=1",
        "-DENABLE_DEBUG=1",
        "-DMULTI_THREADING=0",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
        "-Wno-error",
        "-Wreturn-type",
    ],
 
    shared_libs: [
        "libbase",
        "libcutils",
        "libhardware",
        "liblog",
        "libutils",
    ],
}
