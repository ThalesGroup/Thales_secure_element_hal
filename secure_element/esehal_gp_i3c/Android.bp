cc_library_shared {
    name: "android.hardware.secure_element.thales.libse-gp-i3c",
    vendor: true,
    srcs: [
        "src/checksum.c",
        "src/iso7816_t1.c",
        "src/gpio_core.c",
        "src/libse-gto.c",
        "src/i3c.c",
        "src/transport.c",
        "src/log.c",
    ],

    local_include_dirs: [
        "src",
    ],

    cflags: [
        "-DANDROID",
        "-DENABLE_LOGGING=1",
        "-DENABLE_DEBUG=1",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
        "-Wno-error",
        "-Wreturn-type",
        "-DSE_GTO_GPIO_OFFSET=5",
        "-DGPIO_CHIP_NAME=\"gpiochip2\"",
    ],

    shared_libs: [
        "libbase",
        "libcutils",
        "libhardware",
        "liblog",
        "libutils",
    ],

}
