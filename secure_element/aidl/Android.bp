cc_binary {
    name: "android.hardware.secure_element-service.thales",
    relative_install_path: "hw",
    init_rc: ["android.hardware.secure_element_thales.rc"],
    vintf_fragments: ["android.hardware.secure_element_thales.xml"],
    vendor: true,
    srcs: [
        "SecureElement.cpp",
        "ThalesService.cpp",
    ],


    local_include_dirs: [
        "se-thales",
        // Uncomment to use legacy library on libse-thales, and comment "se-thales" line
//        "se-thales-legacy",        
    ],

    shared_libs: [
        "libbinder_ndk",
        "android.hardware.secure_element-V1-ndk",
        "android.hardware.secure_element.thales.libse-thales",
        // Using libse-thales instead of libse-thales only if -DLEGACY cflags is present
        "android.hardware.secure_element.thales.libse-thales-legacy",        
        "libbase",
        "libcutils",
        "libhardware",
        "liblog",
        "libutils",
    ],

    cflags: [
        "-DANDROID",
// Uncomment LEGACY flag to use legacy library on libse-thales 
//        "-DLEGACY", 
        "-DENABLE_LOGGING=1",
        "-DENABLE_DEBUG=1",
        "-DMULTI_THREADING=0",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
        "-Wno-error",
        "-Wreturn-type",
    ],

    sanitize: {
        memtag_heap: true,
    },
}